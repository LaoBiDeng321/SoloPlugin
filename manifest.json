{
  "manifest_version": 3,
  "name": "本地服务插件管理器",
  "version": "1.1.0",
  "description": "管理本地服务访问时的插件状态",
  "permissions": [
    "management",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icons/icon-16.png",
      "32": "img/icons/icon-32.png",
      "48": "img/icons/icon-48.png",
      "128": "img/icons/icon-128.png"
    },
    "default_title": "本地服务插件管理器"
  },
  "icons": {
    "16": "img/icons/icon-16.png",
    "32": "img/icons/icon-32.png",
    "48": "img/icons/icon-48.png",
    "128": "img/icons/icon-128.png"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  }
}